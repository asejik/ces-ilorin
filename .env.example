# ==============================================================================
# ENVIRONMENT VARIABLES: CES Portal
# Copy this file to .env.local and populate with your credentials
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Provider Configuration (Nodemailer with Gmail App Password or Brevo)
EMAIL_FROM="Citizens Elementary School <ces.admissions@citizensoflightchurch.org>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
